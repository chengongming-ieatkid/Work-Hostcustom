# AI Provider configuration (Bedrock / Muse Spark / Custom OpenAI-compatible)
# Copy this file to .env.local and fill in your values.
# Hoặc cấu hình trực tiếp trong app: Cài đặt → Cấu hình AI Provider (chỉ Admin).

# Provider: bedrock | muse-spark | custom
AI_PROVIDER=bedrock

# Base URL (chat/completions endpoint). Để trống = mặc định của provider.
# Bedrock mặc định: https://bedrock-mantle.<AWS_REGION>.api.aws/v1/chat/completions
AI_BASE_URL=

# API key. Để trống = dùng key đã lưu trong DB (qua UI) hoặc AWS_BEARER_KEY.
AI_API_KEY=

# Tên model. Để trống = mặc định của provider (bedrock: zai.glm-5).
AI_MODEL=

# --- Legacy: AWS Bedrock (vẫn dùng được khi AI_PROVIDER=bedrock) ---
AWS_REGION=us-east-1
AWS_BEARER_KEY=your_absk_bearer_key_here
